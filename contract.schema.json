{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lrtbrabo/dbx-migration-tool/contract.schema.json",
  "title": "SSIS → Databricks Lineage Contract",
  "description": "Machine-readable, package-scoped record of source → transform → target mappings and reconciliation specs per ADR-0001. One contract per SSIS package, git-tracked, generated by contract_agent (#6), adjudicated via Gate 1.",
  "type": "object",
  "required": ["schema_version", "package", "provenance", "connections", "targets"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Contract schema version (e.g., '1.0'). Bumped when contract structure changes.",
      "pattern": "^\\d+\\.\\d+$"
    },
    "package": {
      "type": "object",
      "description": "SSIS package metadata.",
      "required": ["name", "group", "source_dtsx_path", "source_hash"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Package name (e.g., 'Carga Hospital MV')."
        },
        "group": {
          "type": "string",
          "description": "Source group (moderna, mv, tasy, wpd).",
          "enum": ["moderna", "mv", "tasy", "wpd"]
        },
        "source_dtsx_path": {
          "type": "string",
          "description": "Path to source .dtsx file (e.g., 'extracted_dtsx/MV/Carga_Hospital_MV.dtsx')."
        },
        "source_hash": {
          "type": "string",
          "description": "SHA256 hash of source .dtsx (drift detector per ADR-0001)."
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Metadata on contract generation.",
      "required": ["generated_at", "generator"],
      "properties": {
        "generated_at": {
          "type": "string",
          "description": "ISO8601 timestamp of contract generation.",
          "format": "date-time"
        },
        "generator": {
          "type": "string",
          "description": "Agent/tool that generated the contract.",
          "enum": ["contract_agent"]
        },
        "model": {
          "type": "string",
          "description": "Claude model used (e.g., 'claude-3-5-sonnet-20241022')."
        }
      }
    },
    "connections": {
      "type": "array",
      "description": "SSIS connection managers (from dtsx_analyzer).",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Connection name (e.g., 'SIMAH_SQL', 'BARTIRA')."
          },
          "connection_type": {
            "type": "string",
            "description": "Connection type (sqlserver, oracle, ole_db_native, etc.).",
            "enum": ["sqlserver", "oracle", "ole_db_native", "linked_server"]
          },
          "host": {
            "type": ["string", "null"],
            "description": "Database server host (e.g., '10.133.109.5')."
          },
          "port": {
            "type": ["integer", "null"],
            "description": "Database server port (e.g., 1433, 1521)."
          },
          "database": {
            "type": ["string", "null"],
            "description": "Database name (e.g., 'SIMAH_SQL', 'Bartira')."
          },
          "user": {
            "type": ["string", "null"],
            "description": "User identifier (credentials resolved via keyvault; not stored here)."
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "Each target table this package loads (dim, fact, staging).",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_table", "load_semantics", "transform_type", "reconciliation", "confidence"],
        "properties": {
          "target_table": {
            "type": "object",
            "description": "Legacy (DW) and UC target table metadata.",
            "required": ["legacy_name", "uc_fqn"],
            "properties": {
              "legacy_name": {
                "type": "string",
                "description": "Legacy DW table name (e.g., 'STG_ATENDIMENTO', 'DIM_ESPECIALIDADE')."
              },
              "uc_fqn": {
                "type": "string",
                "description": "Unity Catalog fully-qualified name (catalog.schema.table), per IND.GD.DOR-0001 (ADR-0002). Example: 'platfin_hml.silver.silver_mv_atendimento'."
              }
            }
          },
          "load_semantics": {
            "type": "string",
            "description": "Load strategy (full_refresh for skeleton; incremental deferred to #13).",
            "enum": ["full_refresh", "incremental"]
          },
          "transform_type": {
            "type": "string",
            "description": "Discriminator: 'column_mapping' for 1:1 OLE DB flows (structured edges), 'sql_task' for Execute-SQL-Task (opaque SQL).",
            "enum": ["column_mapping", "sql_task"]
          },
          "source": {
            "type": "object",
            "description": "Source definition (connection + query).",
            "required": ["connection"],
            "properties": {
              "connection": {
                "type": "string",
                "description": "Connection name (reference to connections[].name)."
              },
              "query": {
                "type": ["string", "null"],
                "description": "Source query (for 'sql_task' transforms or complex data flows; null if 1:1 table read)."
              },
              "table": {
                "type": ["string", "null"],
                "description": "Source table name (for simple 1:1 reads; null if query-based)."
              }
            }
          },
          "column_mappings": {
            "type": ["array", "null"],
            "description": "Explicit column edges for 'column_mapping' transforms. Null for 'sql_task'.",
            "items": {
              "type": "object",
              "required": ["source_column", "target_column"],
              "properties": {
                "source_column": {
                  "type": "string",
                  "description": "Source column name."
                },
                "target_column": {
                  "type": "string",
                  "description": "Target column name (may differ)."
                },
                "source_data_type": {
                  "type": ["string", "null"],
                  "description": "Source data type (e.g., 'INT', 'VARCHAR(100)')."
                },
                "target_data_type": {
                  "type": ["string", "null"],
                  "description": "Target data type (Spark type, e.g., 'INT', 'STRING')."
                },
                "expression": {
                  "type": ["string", "null"],
                  "description": "Transformation expression (e.g., 'UPPER(source_col)', null if 1:1)."
                }
              }
            }
          },
          "sql": {
            "type": "object",
            "description": "SQL artifacts for 'sql_task' transforms. Null/empty for 'column_mapping'.",
            "properties": {
              "original": {
                "type": ["string", "null"],
                "description": "Original T-SQL / Oracle SQL from Execute-SQL-Task."
              },
              "transpiled": {
                "type": ["string", "null"],
                "description": "Transpiled Spark SQL (post-Lakebridge + transpile_fixup_agent)."
              },
              "target_columns": {
                "type": ["array", "null"],
                "description": "Output column names from the SQL (for reconciliation.hash_columns reference).",
                "items": { "type": "string" }
              }
            }
          },
          "reconciliation": {
            "type": "object",
            "description": "Declarative reconciliation spec (grain keys, hash columns, aggregates, thresholds per #7).",
            "required": ["grain_keys", "hash_columns", "aggregate_metrics"],
            "properties": {
              "grain_keys": {
                "type": "array",
                "description": "Business key(s) identifying one row (for key-level comparison).",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "hash_columns": {
                "type": "array",
                "description": "Columns to include in row-level SHA256 hash (business cols, excl. audit). Subset of or superset of grain_keys.",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "aggregate_metrics": {
                "type": "array",
                "description": "Aggregate functions to compare (detects totals mismatches).",
                "items": {
                  "type": "object",
                  "required": ["column", "function"],
                  "properties": {
                    "column": {
                      "type": "string",
                      "description": "Column to aggregate (ignored for function='count')."
                    },
                    "function": {
                      "type": "string",
                      "description": "Aggregation function.",
                      "enum": ["count", "sum", "count_distinct"]
                    }
                  }
                }
              },
              "thresholds": {
                "type": "object",
                "description": "Tolerance thresholds per check (default: 'exact'). Refined post-Gate-2.",
                "properties": {
                  "row_count": {
                    "type": "string",
                    "description": "Row count threshold ('exact' or tolerance '%' or '±N').",
                    "default": "exact"
                  },
                  "key_match": {
                    "type": "string",
                    "description": "Key set membership threshold (usually 'exact').",
                    "default": "exact"
                  },
                  "hash_match": {
                    "type": "string",
                    "description": "Row content hash threshold (usually 'exact'; '%' for acceptable data drift).",
                    "default": "exact"
                  },
                  "aggregates": {
                    "type": "object",
                    "description": "Per-metric thresholds (future: per-column tolerance rules via adjudication).",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            }
          },
          "confidence": {
            "type": "object",
            "description": "Confidence score and adjudication metadata (Gate 1).",
            "required": ["score"],
            "properties": {
              "score": {
                "type": "number",
                "description": "Confidence (0–1). High for 1:1 flows, medium for inferred keys, low for ambiguous.",
                "minimum": 0,
                "maximum": 1
              },
              "verified_by": {
                "type": ["string", "null"],
                "description": "Human adjudicator identity (email or username) if Gate 1 completed."
              },
              "verified_at": {
                "type": ["string", "null"],
                "description": "ISO8601 timestamp of adjudication.",
                "format": "date-time"
              },
              "notes": {
                "type": ["string", "null"],
                "description": "Adjudicator notes (rationale, ambiguities, escalation context)."
              }
            }
          }
        }
      }
    }
  }
}
